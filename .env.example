# ops-copilot environment. Copy to .env and fill in the secrets:
#   cp .env.example .env
# Generate each secret with:  openssl rand -hex 32

# ---------------------------------------------------------------- auth
# REQUIRED. The API refuses to boot without one. Send it as the
# X-API-Key header (HTTP) or the x-api-key.<key> WebSocket subprotocol
# (never in the URL query string).
OPS_API_KEY=

# REQUIRED by docker compose. The API mints GitHub approval tokens with this;
# the source-control MCP server verifies them with it. Must match on both
# sides. Generate with: openssl rand -hex 32
OPS_APPROVAL_SECRET=

# REQUIRED by docker compose. No weak default: compose and the API fail
# fast if it is unset. Generate with: openssl rand -hex 32
POSTGRES_PASSWORD=

# ---------------------------------------------------------------- LLM
# One of: groq | gemini | ollama | openai_compatible
OPS_LLM_PROVIDER=groq

# Uncomment the key for the provider you chose. Only the chosen provider
# needs a key; the service boots without one (health, MCP and audit stay up).
OPS_GROQ_API_KEY=
# OPS_GEMINI_API_KEY=

# For OPS_LLM_PROVIDER=openai_compatible only:
# OPS_OPENAI_API_BASE=https://your-gateway.example.com/v1
# OPS_OPENAI_API_KEY=

# Optional. Empty means "use the provider's recommended default".
OPS_LLM_MODEL=
OPS_LLM_TEMPERATURE=0.2

# Fully offline option: run Ollama, set OPS_LLM_PROVIDER=ollama. In compose
# the container reaches Ollama at http://ollama:11434 (offline profile).
OPS_OLLAMA_BASE_URL=http://localhost:11434

# ---------------------------------------------------------------- MCP
OPS_MCP_TRANSPORT=http

# Service URLs. The compose defaults (below) are correct when the stack runs
# in Docker; the localhost defaults in settings are for running the API
# outside Docker with `OPS_MCP_TRANSPORT=stdio`.
OPS_OPS_DB_MCP_URL=http://ops-db-mcp:8001/mcp
OPS_SOURCE_CONTROL_MCP_URL=http://source-control-mcp:8002/mcp

# ---------------------------------------------------------------- GitHub
# Optional. Tokenless access works but is limited to 60 requests/hour.
OPS_GITHUB_TOKEN=
OPS_GITHUB_DEFAULT_REPO=psf/requests

# ---------------------------------------------------------------- databases
# REQUIRED for `make seed`. scripts/bootstrap_db.py connects as a superuser
# to create the app databases (the ops user created by compose is one).
OPS_ADMIN_DSN=postgresql://ops:<same-as-POSTGRES_PASSWORD>@localhost:5432/postgres

# App DSNs. Compose service URLs are the default; override with localhost
# variants when running the API on your machine against
# `docker compose up postgres`. Replace <same-as-POSTGRES_PASSWORD> with the
# value you generated above (.env values are not interpolated).
OPS_DATABASE_URL=postgresql://ops:<same-as-POSTGRES_PASSWORD>@postgres:5432/ops_ops
OPS_CHECKPOINT_DB_URL=postgresql://ops:<same-as-POSTGRES_PASSWORD>@postgres:5432/ops_checkpoints

# ---------------------------------------------------------------- SQL guardrails
OPS_SQL_MAX_ROWS=200
OPS_SQL_STATEMENT_TIMEOUT_MS=8000

# ---------------------------------------------------------------- graph budgets
OPS_RUN_TOKEN_BUDGET=80000
OPS_GRAPH_RECURSION_LIMIT=48

# ---------------------------------------------------------------- API server
# S16: local runs bind loopback (127.0.0.1) by default. docker compose passes
# --host 0.0.0.0 explicitly for the api service, so containers are unaffected.
# Uncomment the next line only if you need the API reachable on your LAN.
# OPS_API_HOST=0.0.0.0
OPS_API_PORT=8000
# Comma-separated. Add your console origin if it differs.
OPS_CORS_ORIGINS=http://localhost:3000

# ---------------------------------------------------------------- audit log
# Compose mounts a named volume at /data; on your own machine this defaults
# to ./data/audit.jsonl. Append-only JSONL with a hash chain (tamper-evident
# for append-only attackers, not tamper-proof against file rewrites).
OPS_AUDIT_LOG_PATH=/data/audit.jsonl

# ---------------------------------------------------------------- observability
# Optional. Set to send traces to Arize Phoenix (compose: profile observability).
# OPS_PHOENIX_ENDPOINT=
